+    // A pack beast carries in a StrongBackpack, which BaseCreature.DisplayWeight already
+    // treats as the mark of a pack animal. The beast itself is never "overweight" in stock:
+    // BaseCreature inherits Mobile.MaxWeight, which is int.MaxValue. Give it the same
+    // Str-derived capacity a player gets, so a laden pack train reads as a real load.
+    public static int GetPackCapacity(Mobile beast) => 40 + (int)(3.5 * beast.Str);
+
+    public static int GetPackOverweight(Mobile beast)
+    {
+        if (beast?.Backpack is not StrongBackpack pack)
+        {
+            return 0;
+        }
+
+        return Math.Max(0, pack.TotalWeight - GetPackCapacity(beast));
+    }
+
+    // The mount's own pack (a beetle) plus every pack beast the rider has out with them.
+    public static int GetPackTrainOverweight(Mobile from)
+    {
+        var total = GetPackOverweight(from.Mount as Mobile);
+
+        if (from is PlayerMobile { AllFollowers: not null } pm)
+        {
+            foreach (var follower in pm.AllFollowers)
+            {
+                if (!ReferenceEquals(follower, from.Mount))
+                {
+                    total += GetPackOverweight(follower);
+                }
+            }
+        }
+
+        return total;
+    }
